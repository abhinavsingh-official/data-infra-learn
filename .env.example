# Copy to .env and adjust if needed. Defaults match docker/docker-compose.yml.

# Used by docker-compose to bootstrap Postgres, AND by the backend's admin
# connection (session provisioning only - see MODULE_4_PLAN.md).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=data_infra_learn
# 5433, not 5432 - avoids colliding with a native/Homebrew Postgres already
# running on the default port on the host machine.
POSTGRES_PORT=5433

# Used by the backend (app/core/config.py) to connect - never the superuser above.
POSTGRES_APP_USER=app_role
POSTGRES_APP_PASSWORD=app_role_dev_password
POSTGRES_HOST=localhost

# Module 15 - Auth.js's own role, scoped to the `auth` schema only (search_path
# pinned there - see docker/init/02_auth_role.sh). Deliberately separate from
# app_role: Auth.js's adapter table names (accounts, sessions, users) would
# otherwise collide with this project's own public.accounts/public.users
# tables, which mean something completely different (fintech data, not login
# sessions).
AUTH_DB_USER=auth_role
AUTH_DB_PASSWORD=auth_role_dev_password

API_PORT=8000

# Defaults to true (unset = true). The hosted deployment sets this to
# false - no JVM there, and the Warehouse/Lake/Lakehouse capstones (real
# PySpark/Delta) aren't worth running live just to keep a demo site up;
# README has the "run it locally" instructions instead.
# ENABLE_SPARK_PHASES=true

# Module 6 - the local frontend dev server's origin, for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Module 7 - MongoDB. Root user is provisioning-only (creates/drops
# per-session scoped users), never used for regular request handling -
# same two-tier pattern as the Postgres superuser/app_role split above.
MONGO_SUPERUSER=mongo_admin
MONGO_SUPERUSER_PASSWORD=mongo_admin_dev_password
MONGO_PORT=27017
