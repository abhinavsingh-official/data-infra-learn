NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Module 15 - Auth.js. AUTH_SECRET: any random 32+ byte value, e.g. `openssl
# rand -base64 33`. The DB_* values use auth_role (NOT app_role - see
# docker/init/02_auth_role.sh), matching the root .env's AUTH_DB_USER/
# AUTH_DB_PASSWORD.
AUTH_SECRET=
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_NAME=data_infra_learn
AUTH_DB_USER=auth_role
AUTH_DB_PASSWORD=auth_role_dev_password

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
